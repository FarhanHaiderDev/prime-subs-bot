# Copy to .env and fill in real values. Never commit .env.

# Telegram
BOT_TOKEN=your-telegram-bot-token
ADMIN_CHAT_ID=your-admin-telegram-user-id
SUPPORT_USERNAME=your_support_username

# Suppliers
# Canboso is disabled until its purchase flow is implemented; keep this false.
CANBOSO_ENABLED=false
SUPPLIER_API_KEY=your-canboso-api-key
SUPPLIER_2_API_KEY=your-pandora-sk_live-key

# Pricing: retail = lowest cost * (1 + MARKUP_PERCENT / 100) + MARKUP_FIXED
MARKUP_PERCENT=40
MARKUP_FIXED=0

# Payment destinations (a method is offered only when its value is set)
BINANCE_PAY_ID=your-binance-pay-id-or-email
BEP20_ADDRESS=your-bep20-usdt-address
TRC20_ADDRESS=your-trc20-usdt-address

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=prime_subs_bot

# Encrypts purchased credentials stored in MongoDB (REQUIRED). Generate a key once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it secret and back it up separately: without it stored credentials cannot be read.
# To rotate, put the NEW key first and keep old keys after it, comma-separated.
ENCRYPTION_KEY=your-generated-fernet-key

# Health server port (Render sets this automatically)
PORT=8080
